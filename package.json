{
  "name": "event-ticketing-system",
  "version": "1.0.0",
  "description": "Event Ticketing & Booking System — Clean Architecture + DDD",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/main.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/domain/**/*.ts"
    ]
  }
}
