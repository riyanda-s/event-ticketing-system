{
  "name": "event-ticketing-system",
  "version": "1.0.0",
  "description": "Event Ticketing & Booking System — Clean Architecture + DDD",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "ts-node src/main.ts",
    "migrate": "ts-node src/infrastructure/persistence/postgresql/run-migrations.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.11.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.spec.ts"],
    "collectCoverageFrom": ["src/domain/**/*.ts"]
  }
}
